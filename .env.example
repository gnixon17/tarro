# Tarro runs with no configuration at all: the portfolio is stored in
# ./data/portfolio.json and every price is entered by hand.
#
# Everything below is optional.

# --- Charles Schwab sync --------------------------------------------------
# Register an app at developer.schwab.com and request BOTH products:
# "Accounts and Trading Production" and "Market Data Production".
#
# The callback must be HTTPS and must match what you registered, exactly. A
# local HTTP dev server cannot serve it, so the supported flow is to paste the
# address you get redirected to back into the Connections page.
#
# Note: Schwab refresh tokens last SEVEN DAYS and cannot be extended. Expect to
# reconnect weekly. The app shows the deadline.
# SCHWAB_APP_KEY="your app key"
# SCHWAB_APP_SECRET="your app secret"
# SCHWAB_REDIRECT_URI="https://127.0.0.1:3000/api/schwab/callback"

# --- Secret encryption ----------------------------------------------------
# Encrypts the stored Schwab tokens. Without it a key is generated and written
# to ./data/.tarro-key (0600) — which protects a stray file read or a backup,
# but not someone who already has the data directory. Set this to keep the key
# off disk entirely. Any passphrase of 16+ characters.
# TARRO_SECRET_KEY="a long random passphrase"

# --- Postgres / Supabase persistence -------------------------------------
# Set BOTH to store the portfolio in the `app_state` table (see
# supabase_schema.sql) instead of on the local filesystem. Needed for any
# deployment with an ephemeral disk, such as Vercel.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-service-role-key"

# --- Storage location -----------------------------------------------------
# Where the JSON document and the token file live.
# TARRO_DATA_DIR="./data"

# --- Network ---------------------------------------------------------------
# PORT=3000
#
# The server binds 127.0.0.1 by default. It holds a brokerage OAuth secret and
# refresh token behind an API with no login, so binding anything wider hands an
# authenticated broker session to whoever can route to this machine. Only set
# HOST if you mean that, and put authentication in front of it if you do.
# HOST="127.0.0.1"
#
# Requests must be addressed to one of these host names, which stops a page
# that resolves its own domain to 127.0.0.1 from reaching the API as a
# same-origin caller. localhost, 127.0.0.1 and ::1 are always allowed.
# Comma-separated; "*" turns the check off.
# TARRO_ALLOWED_HOSTS="tarro.internal"
